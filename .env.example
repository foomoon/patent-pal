PATENT_PROVIDER=bigquery
GOOGLE_CLOUD_PROJECT=your-google-cloud-project-id
PATENT_MAX_BYTES_BILLED=150000000000
# Fetch actual abstract snippets only for the selected results. Set to false to disable.
PATENT_ABSTRACT_ENRICHMENT=true

# Local models power query planning and result reranking.
# Supported providers: ollama and openai-compatible (for LM Studio or similar).
LOCAL_MODEL_PROVIDER=ollama
LOCAL_MODEL_BASE_URL=http://127.0.0.1:11434
LOCAL_MODEL_MODEL=llama3.2

# The harness stops after this many retrieval/reflection rounds.
MAX_SEARCH_ITERATIONS=3
MAX_SESSION_BYTES_BILLED=70000000000
